NODE_ENV=development
APP_NAME=mikrotik-manager-enterprise
APP_VERSION=0.1.0
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Đặt bằng SERVER_PORT để dùng chung listener; đặt cổng khác để tách dashboard.
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
DATABASE_URL=postgresql://mme:mme@postgres:5432/mme?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-different-32-byte-secret
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password
BACKUP_STORAGE_PATH=/app/data/backups
LOG_LEVEL=info
# Tùy chọn: đường dẫn tới frontend đã build khi chạy dạng native service.
WEB_DIST_PATH=
