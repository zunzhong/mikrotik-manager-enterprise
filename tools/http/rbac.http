@baseUrl = http://localhost:3000
@userId = demo-user

### RBAC: List permissions
GET {{baseUrl}}/api/v1/rbac/permissions

### RBAC: List roles
GET {{baseUrl}}/api/v1/rbac/roles

### RBAC: Get owner role
GET {{baseUrl}}/api/v1/rbac/roles/owner

### RBAC: Get admin role
GET {{baseUrl}}/api/v1/rbac/roles/admin

### RBAC: List user roles
GET {{baseUrl}}/api/v1/rbac/users/{{userId}}/roles

### RBAC: List effective user permissions
GET {{baseUrl}}/api/v1/rbac/users/{{userId}}/permissions

### RBAC: Assign viewer role
POST {{baseUrl}}/api/v1/rbac/users/{{userId}}/roles
Content-Type: application/json

{
  "roleId": "viewer",
  "assignedBy": "rest-client"
}

### RBAC: Assign admin role
POST {{baseUrl}}/api/v1/rbac/users/{{userId}}/roles
Content-Type: application/json

{
  "roleId": "admin",
  "assignedBy": "rest-client"
}

### RBAC: Assign auditor role
POST {{baseUrl}}/api/v1/rbac/users/{{userId}}/roles
Content-Type: application/json

{
  "roleId": "auditor",
  "assignedBy": "rest-client"
}

### RBAC: Check user audit export permission
POST {{baseUrl}}/api/v1/rbac/check
Content-Type: application/json

{
  "principal": {
    "userId": "{{userId}}"
  },
  "permission": "audit:export"
}

### RBAC: Check viewer audit export denial
POST {{baseUrl}}/api/v1/rbac/check
Content-Type: application/json

{
  "principal": {
    "roleIds": ["viewer"]
  },
  "permission": "audit:export"
}

### RBAC: Check explicit permission
POST {{baseUrl}}/api/v1/rbac/check
Content-Type: application/json

{
  "principal": {
    "permissions": ["device:read"]
  },
  "permission": "device:read"
}

### RBAC: Check super admin bypass
POST {{baseUrl}}/api/v1/rbac/check
Content-Type: application/json

{
  "principal": {
    "isSuperAdmin": true
  },
  "permission": "rbac:manage"
}

### RBAC: Remove auditor role
DELETE {{baseUrl}}/api/v1/rbac/users/{{userId}}/roles/auditor

### Audit: RBAC role assigned events
GET {{baseUrl}}/api/v1/audit?action=rbac.user_role.assigned&limit=20

### Audit: RBAC permission checked events
GET {{baseUrl}}/api/v1/audit?action=rbac.permission.checked&limit=20

### Audit: RBAC role removed events
GET {{baseUrl}}/api/v1/audit?action=rbac.user_role.removed&limit=20
