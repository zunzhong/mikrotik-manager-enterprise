generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model DeviceGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices Device[]
}

model Device {
  id                String   @id @default(cuid())
  name              String
  host              String
  port              Int      @default(8728)
  username          String
  passwordEncrypted String
  useTls            Boolean  @default(false)
  loginMode         String   @default("auto")
  status            String   @default("unknown")
  lastSeenAt        DateTime?
  lastError         String?
  tags              String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  groupId String?
  group   DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  inventorySnapshots InventorySnapshot[]
  inventoryDiffs     InventoryDiff[]

  @@index([host])
  @@index([status])
  @@index([groupId])
}

model InventorySnapshot {
  id          String   @id @default(cuid())
  deviceId    String
  collectedAt DateTime @default(now())
  source      String   @default("manual")
  status      String   @default("completed")
  summary     Json?

  device  Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sections InventorySection[]

  previousDiffs InventoryDiff[] @relation("PreviousSnapshot")
  currentDiffs  InventoryDiff[] @relation("CurrentSnapshot")

  @@index([deviceId])
  @@index([collectedAt])
}

model InventorySection {
  id         String @id @default(cuid())
  snapshotId String
  name       String
  category   String
  path       String
  itemCount  Int    @default(0)
  raw        Json?

  snapshot InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  items    InventoryItem[]

  @@index([snapshotId])
  @@index([category])
  @@index([path])
}

model InventoryItem {
  id        String @id @default(cuid())
  sectionId String
  externalId String?
  name      String?
  disabled  Boolean?
  raw       Json

  section InventorySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([externalId])
  @@index([name])
}

model InventoryDiff {
  id                 String   @id @default(cuid())
  deviceId           String
  previousSnapshotId String
  currentSnapshotId  String
  createdAt          DateTime @default(now())
  summary            Json?
  changeCount         Int      @default(0)

  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  previousSnapshot InventorySnapshot @relation("PreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Cascade)
  currentSnapshot  InventorySnapshot @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Cascade)
  changes          InventoryDiffChange[]

  @@index([deviceId])
  @@index([createdAt])
  @@index([previousSnapshotId])
  @@index([currentSnapshotId])
}

model InventoryDiffChange {
  id        String @id @default(cuid())
  diffId    String
  category  String
  path      String
  changeType String
  itemKey   String?
  before    Json?
  after     Json?

  diff InventoryDiff @relation(fields: [diffId], references: [id], onDelete: Cascade)

  @@index([diffId])
  @@index([category])
  @@index([path])
  @@index([changeType])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}
