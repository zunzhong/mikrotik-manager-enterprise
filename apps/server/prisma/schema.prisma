generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         String    @default("admin")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles               UserRole[]
  auditLogs           AuditLog[]
  mfaSecret           MfaSecret?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([category])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model DeviceGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  devices     Device[]
}

model Device {
  id                String    @id @default(cuid())
  name              String
  host              String
  port              Int       @default(8728)
  username          String
  passwordEncrypted String
  useTls            Boolean   @default(false)
  loginMode         String    @default("auto")
  status            String    @default("unknown")
  lastSeenAt        DateTime?
  lastError         String?
  tags              Json      @default("[]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  groupId String?
  group   DeviceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  inventorySnapshots InventorySnapshot[]
  inventoryDiffs     InventoryDiff[]
  complianceReports  ComplianceReport[]
  alerts             Alert[]
  backups            BackupRecord[]
  trafficSamples     TrafficSample[]
  alertRuleConfigs   DeviceAlertRuleConfig[]

  @@index([host])
  @@index([status])
  @@index([groupId])
}

model InventorySnapshot {
  id          String   @id @default(cuid())
  deviceId    String
  collectedAt DateTime @default(now())
  source      String   @default("manual")
  status      String   @default("completed")
  summary     Json?

  device   Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sections InventorySection[]

  previousDiffs InventoryDiff[] @relation("PreviousSnapshot")
  currentDiffs  InventoryDiff[] @relation("CurrentSnapshot")

  @@index([deviceId])
  @@index([collectedAt])
}

model InventorySection {
  id         String @id @default(cuid())
  snapshotId String
  name       String
  category   String
  path       String
  itemCount  Int    @default(0)
  raw        Json?

  snapshot InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  items    InventoryItem[]

  @@index([snapshotId])
  @@index([category])
  @@index([path])
}

model InventoryItem {
  id         String   @id @default(cuid())
  sectionId  String
  externalId String?
  name       String?
  disabled   Boolean?
  raw        Json

  section InventorySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([externalId])
  @@index([name])
}

model InventoryDiff {
  id                 String   @id @default(cuid())
  deviceId           String
  previousSnapshotId String
  currentSnapshotId  String
  createdAt          DateTime @default(now())
  summary            Json?
  changeCount        Int      @default(0)

  device           Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  previousSnapshot InventorySnapshot     @relation("PreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Cascade)
  currentSnapshot  InventorySnapshot     @relation("CurrentSnapshot", fields: [currentSnapshotId], references: [id], onDelete: Cascade)
  changes          InventoryDiffChange[]

  @@index([deviceId])
  @@index([createdAt])
}

model InventoryDiffChange {
  id         String  @id @default(cuid())
  diffId     String
  category   String
  path       String
  changeType String
  itemKey    String?
  before     Json?
  after      Json?

  diff InventoryDiff @relation(fields: [diffId], references: [id], onDelete: Cascade)

  @@index([diffId])
  @@index([category])
  @@index([path])
  @@index([changeType])
}

model ComplianceReport {
  id         String   @id @default(cuid())
  deviceId   String
  snapshotId String?
  status     String
  score      Int
  summary    Json?
  createdAt  DateTime @default(now())

  device  Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  results ComplianceResult[]

  @@index([deviceId])
  @@index([createdAt])
  @@index([status])
}

model ComplianceResult {
  id        String @id @default(cuid())
  reportId  String
  policyKey String
  severity  String
  status    String
  message   String
  evidence  Json?

  report ComplianceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([policyKey])
  @@index([status])
  @@index([severity])
}

model BackupRecord {
  id          String    @id @default(cuid())
  deviceId    String
  type        String
  status      String    @default("pending")
  fileName    String
  filePath    String?
  sizeBytes   Int?
  checksum    String?
  metadata    Json?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Alert {
  id             String    @id @default(cuid())
  deviceId       String?
  ruleKey        String
  severity       String
  status         String    @default("open")
  title          String
  message        String
  source         String
  metadata       Json?
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([ruleKey])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model DeviceAlertRuleConfig {
  id        String   @id @default(cuid())
  deviceId  String
  ruleKey   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, ruleKey])
  @@index([deviceId])
  @@index([ruleKey])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([usedAt])
}

model MfaSecret {
  id              String    @id @default(cuid())
  userId          String    @unique
  secretEncrypted String
  enabled         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  enabledAt       DateTime?
  disabledAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled])
}

model DeviceSnapshot {
  id          String   @id @default(cuid())
  deviceId    String
  collectedAt DateTime @default(now())
  online      Boolean  @default(false)
  latencyMs   Int?
  error       String?
  identity    Json?
  resource    Json?
  routerboard Json?
  health      Json?
  services    Json?
  interfaces  Json?
  addresses   Json?
  routes      Json?
  packages    Json?
  createdAt   DateTime @default(now())

  @@index([deviceId])
  @@index([collectedAt])
}

model TrafficSample {
  id            String   @id @default(cuid())
  deviceId      String
  interfaceName String
  collectedAt   DateTime @default(now())
  rxBytes       BigInt
  txBytes       BigInt
  rxDeltaBytes  BigInt   @default(0)
  txDeltaBytes  BigInt   @default(0)
  rxBps         Float    @default(0)
  txBps         Float    @default(0)
  running       Boolean  @default(false)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, collectedAt])
  @@index([deviceId, interfaceName, collectedAt])
}
