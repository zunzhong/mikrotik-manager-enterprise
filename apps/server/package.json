{
  "name": "@mme/server",
  "version": "5.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:generate:sqlite": "node scripts/generate-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma",
    "prisma:sql:sqlite": "node scripts/generate-sqlite-schema.mjs && node scripts/generate-sqlite-sql.mjs",
    "prisma:push": "prisma db push",
    "prisma:push:sqlite": "node scripts/generate-sqlite-schema.mjs && prisma db push --schema prisma/schema.sqlite.prisma",
    "setup:native": "node dist/scripts/setup-native.js",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/static": "^9.1.1",
    "@mme/routeros-core": "workspace:*",
    "@mme/routeros-sdk": "workspace:*",
    "@prisma/client": "^6.19.3",
    "basic-ftp": "6.0.1",
    "fastify": "^5.2.1",
    "luxon": "^3.7.2",
    "nodemailer": "^9.0.1",
    "pino": "^9.6.0",
    "ssh2-sftp-client": "12.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.0",
    "@types/ssh2-sftp-client": "9.0.6",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
