#!/usr/bin/env bash
set -Eeuo pipefail

ACTION="${1:-status}"
APP_DIR="${MME_HOME:-/opt/mikrotik-manager-enterprise}"
DATA_DIR="${MME_DATA:-/var/lib/mikrotik-manager-enterprise}"
CONFIG_DIR="${MME_CONFIG:-/etc/mikrotik-manager-enterprise}"
ENV_FILE="$CONFIG_DIR/mme.env"
LOGIN_FILE="/root/mme-thong-tin-dang-nhap.txt"
NODE="$APP_DIR/runtime/node"
SERVICE="mme.service"
BACKEND_PORT=3000
FRONTEND_PORT=3000
SYSLOG_PORT=514

valid_port() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] && (( 1 <= $1 && $1 <= 65535 ))
}

read_env_value() {
  local key="$1"
  [[ -r "$ENV_FILE" ]] || return 0
  awk -F= -v key="$key" '$1 == key {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE"
}

load_environment_file() {
  local key value
  while IFS='=' read -r key value; do
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    export "$key=$value"
  done < "$ENV_FILE"
}

refresh_runtime_ports() {
  local configured_backend configured_frontend configured_syslog
  configured_backend="$(read_env_value SERVER_PORT)"
  configured_frontend="$(read_env_value FRONTEND_PORT)"
  configured_syslog="$(read_env_value SYSLOG_PORT)"
  valid_port "$configured_backend" && BACKEND_PORT="$configured_backend"
  if valid_port "$configured_frontend"; then
    FRONTEND_PORT="$configured_frontend"
  else
    FRONTEND_PORT="$BACKEND_PORT"
  fi
  valid_port "$configured_syslog" && SYSLOG_PORT="$configured_syslog"
}

set_env_value() {
  local key="$1"
  local value="$2"
  local temporary
  temporary="$(mktemp)"
  if [[ -f "$ENV_FILE" ]]; then
    awk -v key="$key" -v value="$value" '
      BEGIN { found = 0 }
      index($0, key "=") == 1 { print key "=" value; found = 1; next }
      { print }
      END { if (!found) print key "=" value }
    ' "$ENV_FILE" > "$temporary"
  else
    printf '%s=%s\n' "$key" "$value" > "$temporary"
  fi
  install -m 0600 "$temporary" "$ENV_FILE"
  rm -f "$temporary"
}

assert_port_available() {
  local port="$1"
  local label="$2"
  "$NODE" -e '
    const net = require("node:net");
    const server = net.createServer();
    server.once("error", () => process.exit(1));
    server.listen(Number(process.argv[1]), "127.0.0.1", () => server.close(() => process.exit(0)));
  ' "$port" || {
    echo "$label $port is already in use. Choose another port or stop the conflicting process." >&2
    return 1
  }
}

require_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || {
    echo 'This command requires root privileges. Run it with sudo.' >&2
    exit 1
  }
}

require_systemd() {
  command -v systemctl >/dev/null 2>&1 || {
    echo 'systemctl was not found; MME requires Ubuntu Server with systemd.' >&2
    exit 1
  }
  [[ -d /run/systemd/system ]] || {
    echo 'systemd is not running as PID 1; the MME service cannot be managed.' >&2
    exit 1
  }
}

secret() {
  openssl rand -hex "${1:-32}"
}

public_host_for_listener() {
  local host="${1:-127.0.0.1}"
  if [[ "$host" == '0.0.0.0' || "$host" == '::' ]]; then
    hostname -I 2>/dev/null | awk '{print $1; exit}'
  else
    printf '%s' "$host"
  fi
}

installed_version() {
  if [[ -s "$APP_DIR/VERSION" ]]; then
    tr -d '[:space:]' < "$APP_DIR/VERSION"
  elif command -v dpkg-query >/dev/null 2>&1 &&
    dpkg-query -W -f='${Version}' mikrotik-manager-enterprise >/dev/null 2>&1; then
    dpkg-query -W -f='${Version}' mikrotik-manager-enterprise
  else
    echo 'unknown'
  fi
}

prepare_directories() {
  install -d -m 0750 "$CONFIG_DIR"
  install -d -m 0750 "$DATA_DIR" "$DATA_DIR/data" "$DATA_DIR/backups" "$DATA_DIR/logs"
}

initialize_env() {
  local version
  version="$(installed_version)"

  if [[ -f "$ENV_FILE" ]]; then
    set_env_value APP_VERSION "$version"
    set_env_value WEB_DIST_PATH "$APP_DIR/web"
    set_env_value SQLITE_SCHEMA_SQL "$APP_DIR/prisma/schema.sqlite.sql"
    set_env_value PRISMA_POSTGRESQL_CLIENT_PATH "$APP_DIR/prisma-client-postgresql"
    set_env_value PRISMA_POSTGRESQL_SCHEMA "$APP_DIR/prisma/schema.postgresql.prisma"
    set_env_value PRISMA_MYSQL_CLIENT_PATH "$APP_DIR/prisma-client-mysql"
    set_env_value PRISMA_MYSQL_SCHEMA "$APP_DIR/prisma/schema.mysql.prisma"
    set_env_value PRISMA_CLI_PATH "$APP_DIR/node_modules/prisma/build/index.js"
    if valid_port "${MME_BACKEND_PORT:-}"; then
      set_env_value SERVER_PORT "$MME_BACKEND_PORT"
    fi
    local existing_backend
    existing_backend="$(read_env_value SERVER_PORT)"
    valid_port "$existing_backend" || {
      existing_backend=3000
      set_env_value SERVER_PORT "$existing_backend"
    }
    if valid_port "${MME_FRONTEND_PORT:-}"; then
      set_env_value FRONTEND_PORT "$MME_FRONTEND_PORT"
    elif ! valid_port "$(read_env_value FRONTEND_PORT)"; then
      set_env_value FRONTEND_PORT "$existing_backend"
    fi
    [[ -n "${MME_SERVER_HOST:-}" ]] && set_env_value SERVER_HOST "$MME_SERVER_HOST"
    [[ -n "${MME_FRONTEND_HOST:-}" ]] && set_env_value FRONTEND_HOST "$MME_FRONTEND_HOST"
    [[ -n "${MME_DATABASE_URL:-}" ]] && set_env_value DATABASE_URL "$MME_DATABASE_URL"
    [[ -n "$(read_env_value SYSLOG_ENABLED)" ]] || set_env_value SYSLOG_ENABLED true
    [[ -n "$(read_env_value SYSLOG_UDP_ENABLED)" ]] || set_env_value SYSLOG_UDP_ENABLED true
    [[ -n "$(read_env_value SYSLOG_TCP_ENABLED)" ]] || set_env_value SYSLOG_TCP_ENABLED true
    [[ -n "$(read_env_value SYSLOG_BIND_ADDRESS)" ]] || set_env_value SYSLOG_BIND_ADDRESS 0.0.0.0
    if valid_port "${MME_SYSLOG_PORT:-}"; then
      set_env_value SYSLOG_PORT "$MME_SYSLOG_PORT"
    elif ! valid_port "$(read_env_value SYSLOG_PORT)"; then
      set_env_value SYSLOG_PORT 514
    fi
    [[ -n "$(read_env_value SYSLOG_RETENTION_DAYS)" ]] || set_env_value SYSLOG_RETENTION_DAYS 30
    [[ -n "$(read_env_value SYSLOG_MAX_RECORDS)" ]] || set_env_value SYSLOG_MAX_RECORDS 500000
    [[ -n "$(read_env_value SYSLOG_ACCEPT_UNMATCHED)" ]] || set_env_value SYSLOG_ACCEPT_UNMATCHED true
    [[ -n "$(read_env_value DEFAULT_ADMIN_EMAIL)" ]] ||
      set_env_value DEFAULT_ADMIN_EMAIL admin@example.com
    [[ -n "$(read_env_value DEFAULT_ADMIN_PASSWORD)" ]] ||
      set_env_value DEFAULT_ADMIN_PASSWORD "$(secret 12)"
    chmod 0600 "$ENV_FILE"
    return
  fi

  local admin_password
  local backend_host backend_port frontend_host frontend_port database_url syslog_port
  admin_password="$(secret 12)"
  backend_port="${MME_BACKEND_PORT:-3000}"
  valid_port "$backend_port" || backend_port=3000
  frontend_port="${MME_FRONTEND_PORT:-$backend_port}"
  valid_port "$frontend_port" || frontend_port="$backend_port"
  if [[ -n "${MME_SERVER_HOST:-}" ]]; then
    backend_host="$MME_SERVER_HOST"
  elif [[ "$frontend_port" == "$backend_port" ]]; then
    backend_host=0.0.0.0
  else
    backend_host=127.0.0.1
  fi
  frontend_host="${MME_FRONTEND_HOST:-0.0.0.0}"
  database_url="${MME_DATABASE_URL:-file:$DATA_DIR/data/mme.db}"
  syslog_port="${MME_SYSLOG_PORT:-514}"
  valid_port "$syslog_port" || syslog_port=514
  cat > "$ENV_FILE" <<EOF
NODE_ENV=production
APP_NAME=mikrotik-manager-enterprise
APP_VERSION=$version
SERVER_HOST=$backend_host
SERVER_PORT=$backend_port
FRONTEND_HOST=$frontend_host
FRONTEND_PORT=$frontend_port
DATABASE_URL=$database_url
JWT_SECRET=$(secret 32)
ENCRYPTION_KEY=$(secret 32)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=$admin_password
SYSLOG_ENABLED=true
SYSLOG_UDP_ENABLED=true
SYSLOG_TCP_ENABLED=true
SYSLOG_BIND_ADDRESS=0.0.0.0
SYSLOG_PORT=$syslog_port
SYSLOG_RETENTION_DAYS=30
SYSLOG_MAX_RECORDS=500000
SYSLOG_ACCEPT_UNMATCHED=true
BACKUP_STORAGE_PATH=$DATA_DIR/backups
WEB_DIST_PATH=$APP_DIR/web
SQLITE_SCHEMA_SQL=$APP_DIR/prisma/schema.sqlite.sql
PRISMA_POSTGRESQL_CLIENT_PATH=$APP_DIR/prisma-client-postgresql
PRISMA_POSTGRESQL_SCHEMA=$APP_DIR/prisma/schema.postgresql.prisma
PRISMA_MYSQL_CLIENT_PATH=$APP_DIR/prisma-client-mysql
PRISMA_MYSQL_SCHEMA=$APP_DIR/prisma/schema.mysql.prisma
PRISMA_CLI_PATH=$APP_DIR/node_modules/prisma/build/index.js
LOG_LEVEL=info
EOF
  chmod 0600 "$ENV_FILE"
}

write_login_file() {
  local dashboard_listener_host dashboard_host temporary
  if [[ "$FRONTEND_PORT" == "$BACKEND_PORT" ]]; then
    dashboard_listener_host="${SERVER_HOST:-127.0.0.1}"
  else
    dashboard_listener_host="${FRONTEND_HOST:-127.0.0.1}"
  fi
  dashboard_host="$(public_host_for_listener "$dashboard_listener_host")"
  [[ -n "$dashboard_host" ]] || dashboard_host=127.0.0.1
  temporary="$(mktemp)"
  printf 'URL: http://%s:%s\nBackend API: http://127.0.0.1:%s\nEmail: %s\nPassword: %s\n' \
    "$dashboard_host" "$FRONTEND_PORT" "$BACKEND_PORT" \
    "$DEFAULT_ADMIN_EMAIL" "$DEFAULT_ADMIN_PASSWORD" \
    > "$temporary"
  install -m 0600 "$temporary" "$LOGIN_FILE"
  rm -f "$temporary"
}

ensure_login_file() {
  if [[ -s "$LOGIN_FILE" ]]; then
    chmod 0600 "$LOGIN_FILE"
    return
  fi

  local credential_script="$APP_DIR/dist/scripts/ensure-login-credentials.js"
  [[ -f "$credential_script" ]] || {
    echo 'The MME payload is incomplete: ensure-login-credentials.js is missing.' >&2
    return 1
  }
  MME_REPAIR_LOGIN_CREDENTIALS=1 "$NODE" "$credential_script"
  write_login_file
  echo "Initial sign-in details were created at $LOGIN_FILE."
}

database_check() {
  require_root
  require_systemd
  local database_url engine server_host check_host check_url_host
  database_url="$(read_env_value DATABASE_URL)"
  case "$database_url" in
    file:*) engine='SQLite' ;;
    postgresql://* | postgres://*) engine='PostgreSQL' ;;
    mysql://*) engine='MariaDB/MySQL' ;;
    '')
      echo "DATABASE_URL is missing from $ENV_FILE." >&2
      return 1
      ;;
    *)
      echo "Unsupported DATABASE_URL in $ENV_FILE." >&2
      return 1
      ;;
  esac

  server_host="$(read_env_value SERVER_HOST)"
  [[ -n "$server_host" ]] || server_host=127.0.0.1
  if [[ "$server_host" == '0.0.0.0' || "$server_host" == '::' ]]; then
    check_host=127.0.0.1
  else
    check_host="$server_host"
  fi
  [[ "$check_host" == *:* ]] && check_url_host="[$check_host]" || check_url_host="$check_host"

  echo "Database engine: $engine"
  echo "Configuration file: $ENV_FILE"
  if systemctl is-active --quiet "$SERVICE" &&
    curl --fail --silent --max-time 5 "http://$check_url_host:$BACKEND_PORT/ready" |
      grep -q '"database":true'; then
    echo 'Database status: connected'
  else
    echo 'Database status: not verified'
    return 1
  fi
}

backup_state() {
  local has_data=0
  local has_config=0
  [[ -f "$DATA_DIR/data/mme.db" ]] && has_data=1
  [[ -f "$ENV_FILE" ]] && has_config=1
  if [[ $has_data -eq 0 && $has_config -eq 0 ]]; then
    echo ''
    return 0
  fi

  local target
  target="$DATA_DIR/backups/mme-before-upgrade-$(date +%Y%m%d-%H%M%S).tar.gz"
  local entries=()
  [[ $has_data -eq 1 ]] && entries+=("${DATA_DIR#/}/data/mme.db")
  [[ $has_config -eq 1 ]] && entries+=("${ENV_FILE#/}")
  tar --create --gzip --file "$target" --directory / "${entries[@]}"
  echo "$target"
}

restore_state() {
  local archive="${1:-}"
  [[ -n "$archive" && -f "$archive" ]] || return 0

  local temporary
  temporary="$(mktemp -d)"
  tar --extract --gzip --file "$archive" --directory "$temporary"
  if [[ -f "$temporary/${DATA_DIR#/}/data/mme.db" ]]; then
    install -m 0640 "$temporary/${DATA_DIR#/}/data/mme.db" "$DATA_DIR/data/mme.db"
  fi
  if [[ -f "$temporary/${ENV_FILE#/}" ]]; then
    install -m 0600 "$temporary/${ENV_FILE#/}" "$ENV_FILE"
  fi
  rm -rf "$temporary"
}

wait_ready() {
  local timeout="${1:-90}"
  local deadline=$((SECONDS + timeout))
  while (( SECONDS < deadline )); do
    if curl --fail --silent --show-error --max-time 3 \
      "http://127.0.0.1:$BACKEND_PORT/ready" 2>/dev/null | grep -q '"status":"ready"'; then
      return 0
    fi
    sleep 2
  done
  echo "MME did not become ready within ${timeout} seconds." >&2
  journalctl -u "$SERVICE" --no-pager -n 100 >&2 || true
  return 1
}

network_check() {
  local server_host frontend_host listener_host check_host check_url_host public_host
  server_host="$(read_env_value SERVER_HOST)"
  frontend_host="$(read_env_value FRONTEND_HOST)"
  [[ -n "$server_host" ]] || server_host=127.0.0.1
  [[ -n "$frontend_host" ]] || frontend_host="$server_host"
  if [[ "$FRONTEND_PORT" == "$BACKEND_PORT" ]]; then
    listener_host="$server_host"
  else
    listener_host="$frontend_host"
  fi
  if [[ "$listener_host" == '0.0.0.0' || "$listener_host" == '::' ]]; then
    check_host=127.0.0.1
  else
    check_host="$listener_host"
  fi
  [[ "$check_host" == *:* ]] && check_url_host="[$check_host]" || check_url_host="$check_host"
  public_host="$(public_host_for_listener "$listener_host")"
  [[ -n "$public_host" ]] || public_host="$check_host"

  echo "Configured dashboard listener: $listener_host:$FRONTEND_PORT"
  echo "Suggested LAN URL: http://$public_host:$FRONTEND_PORT"
  if command -v ss >/dev/null 2>&1; then
    ss --listening --numeric --tcp --process 2>/dev/null |
      awk -v suffix=":$FRONTEND_PORT" 'NR == 1 || index($4, suffix) == length($4) - length(suffix) + 1'
  fi
  curl --fail --silent --show-error --max-time 5 \
    "http://$check_url_host:$FRONTEND_PORT/ready"
  printf '\n'
  if command -v ufw >/dev/null 2>&1; then
    LC_ALL=C ufw status verbose
  else
    echo 'UFW is not installed.'
  fi
}

syslog_check() {
  require_root
  require_systemd
  refresh_runtime_ports
  local enabled udp_enabled tcp_enabled
  enabled="$(read_env_value SYSLOG_ENABLED)"
  udp_enabled="$(read_env_value SYSLOG_UDP_ENABLED)"
  tcp_enabled="$(read_env_value SYSLOG_TCP_ENABLED)"
  if [[ "$enabled" != true ]]; then
    echo 'Syslog receiver: disabled'
    return 0
  fi
  systemctl is-active --quiet "$SERVICE" || {
    echo 'MME service is not active.' >&2
    return 1
  }
  command -v ss >/dev/null 2>&1 || {
    echo 'The ss utility is required to validate Syslog listeners.' >&2
    return 1
  }
  if [[ "$udp_enabled" == true ]]; then
    ss --listening --numeric --udp |
      awk -v suffix=":$SYSLOG_PORT" 'NR > 1 && index($5, suffix) == length($5) - length(suffix) + 1 {found=1} END {exit !found}' || {
        echo "Syslog UDP listener is missing on port $SYSLOG_PORT." >&2
        return 1
      }
  fi
  if [[ "$tcp_enabled" == true ]]; then
    ss --listening --numeric --tcp |
      awk -v suffix=":$SYSLOG_PORT" 'NR > 1 && index($4, suffix) == length($4) - length(suffix) + 1 {found=1} END {exit !found}' || {
        echo "Syslog TCP listener is missing on port $SYSLOG_PORT." >&2
        return 1
      }
  fi
  echo "MME Syslog listener check: PASS (UDP=$udp_enabled TCP=$tcp_enabled port=$SYSLOG_PORT)"
}

remove_syslog_firewall_rules() {
  command -v ufw >/dev/null 2>&1 || return 0
  LC_ALL=C ufw status | grep -q '^Status: active$' || return 0
  local rule
  while IFS= read -r rule; do
    [[ -n "$rule" ]] && ufw --force delete "$rule" >/dev/null 2>&1 || true
  done < <(
    LC_ALL=C ufw status numbered |
      sed -n 's/^\[[[:space:]]*\([0-9][0-9]*\)\].*MME Syslog.*/\1/p' |
      sort -rn
  )
}

feature_check() {
  require_root
  require_systemd
  local server_host frontend_host listener_host check_host check_url_host index_file asset assets
  systemctl is-active --quiet "$SERVICE" || {
    echo 'MME service is not active.' >&2
    return 1
  }
  database_check
  command -v ping >/dev/null 2>&1 || {
    echo 'Linux ping support is missing. Reinstall the DEB so iputils-ping is installed.' >&2
    return 1
  }

  server_host="$(read_env_value SERVER_HOST)"
  frontend_host="$(read_env_value FRONTEND_HOST)"
  [[ -n "$server_host" ]] || server_host=127.0.0.1
  [[ -n "$frontend_host" ]] || frontend_host="$server_host"
  if [[ "$FRONTEND_PORT" == "$BACKEND_PORT" ]]; then
    listener_host="$server_host"
  else
    listener_host="$frontend_host"
  fi
  if [[ "$listener_host" == '0.0.0.0' || "$listener_host" == '::' ]]; then
    check_host=127.0.0.1
  else
    check_host="$listener_host"
  fi
  [[ "$check_host" == *:* ]] && check_url_host="[$check_host]" || check_url_host="$check_host"

  index_file="$(mktemp)"
  curl --fail --silent --show-error --max-time 10 \
    "http://$check_url_host:$FRONTEND_PORT/" > "$index_file"
  grep -q '<div id="root"></div>' "$index_file" || {
    rm -f "$index_file"
    echo 'The dashboard HTML is incomplete.' >&2
    return 1
  }
  assets="$(grep -oE '/assets/[^" ]+\.(css|js)' "$index_file" | sort -u)"
  rm -f "$index_file"
  [[ -n "$assets" ]] || {
    echo 'The dashboard does not reference its CSS/JavaScript assets.' >&2
    return 1
  }
  while IFS= read -r asset; do
    curl --fail --silent --show-error --max-time 15 \
      --output /dev/null "http://$check_url_host:$FRONTEND_PORT$asset"
  done <<< "$assets"

  curl --fail --silent --show-error --max-time 10 \
    "http://127.0.0.1:$BACKEND_PORT/api/v1/topology" |
    grep -q '"success":true' || {
      echo 'The Topology API did not pass its platform check.' >&2
      return 1
    }
  if [[ "$(read_env_value SYSLOG_ENABLED)" == true ]]; then
    syslog_check
  fi

  echo 'MME Linux platform feature check: PASS'
  echo 'Dashboard HTML/CSS/JavaScript: ready'
  echo 'Backend proxy and Topology API: ready'
  echo 'Linux ping runtime: ready'
  echo 'Use “Check API connection” in each device Terminal to verify that router credentials and RouterOS policies permit device operations.'
}

install_or_upgrade() {
  require_root
  require_systemd
  [[ -x "$NODE" ]] || {
    echo "The bundled Node runtime is missing at $NODE. Reinstall the DEB package." >&2
    exit 1
  }
  [[ -f "$APP_DIR/dist/scripts/setup-native.js" ]] || {
    echo 'The MME payload is incomplete: setup-native.js is missing.' >&2
    exit 1
  }

  local was_active=0
  local backup=''
  if systemctl is-active --quiet "$SERVICE"; then
    was_active=1
    systemctl stop "$SERVICE"
  fi

  rollback_unexpected_error() {
    local exit_code=$?
    trap - ERR
    set +e
    restore_state "$backup"
    [[ $was_active -eq 1 ]] && systemctl start "$SERVICE"
    echo 'Installation failed unexpectedly; the database and configuration were restored.' >&2
    exit "$exit_code"
  }
  trap rollback_unexpected_error ERR

  prepare_directories
  backup="$(backup_state)"
  initialize_env
  # Không `source` file cấu hình: URL PostgreSQL có thể chứa `&` và các ký tự
  # shell khác. Chỉ nhập các cặp KEY=VALUE hợp lệ mà không thực thi nội dung.
  load_environment_file
  BACKEND_PORT="$SERVER_PORT"
  FRONTEND_PORT="${FRONTEND_PORT:-$SERVER_PORT}"
  assert_port_available "$BACKEND_PORT" 'Backend/API port'
  if [[ "$FRONTEND_PORT" != "$BACKEND_PORT" ]]; then
    assert_port_available "$FRONTEND_PORT" 'Frontend/dashboard port'
  fi

  if ! "$NODE" "$APP_DIR/dist/scripts/setup-native.js"; then
    trap - ERR
    set +e
    restore_state "$backup"
    [[ $was_active -eq 1 ]] && systemctl start "$SERVICE" || true
    echo 'Upgrade failed; the database and configuration were rolled back.' >&2
    exit 1
  fi

  systemctl daemon-reload
  systemctl enable "$SERVICE"
  systemctl restart "$SERVICE"
  if ! wait_ready 90; then
    trap - ERR
    set +e
    systemctl stop "$SERVICE" || true
    restore_state "$backup"
    [[ $was_active -eq 1 ]] && systemctl start "$SERVICE" || true
    echo 'The new service did not become ready; the database and configuration were rolled back.' >&2
    exit 1
  fi

  trap - ERR
  ensure_login_file
  local dashboard_listener_host dashboard_public_host
  if [[ "$FRONTEND_PORT" == "$BACKEND_PORT" ]]; then
    dashboard_listener_host="${SERVER_HOST:-127.0.0.1}"
  else
    dashboard_listener_host="${FRONTEND_HOST:-127.0.0.1}"
  fi
  dashboard_public_host="$(public_host_for_listener "$dashboard_listener_host")"
  [[ -n "$dashboard_public_host" ]] || dashboard_public_host=127.0.0.1
  echo "MME $(installed_version) is installed and running."
  echo "Dashboard: http://$dashboard_public_host:$FRONTEND_PORT · Backend API: http://127.0.0.1:$BACKEND_PORT"
  [[ -f "$LOGIN_FILE" ]] && echo "Initial sign-in details: $LOGIN_FILE"
}

refresh_runtime_ports

case "$ACTION" in
  install | upgrade)
    install_or_upgrade
    ;;
  start)
    require_root
    require_systemd
    systemctl start "$SERVICE"
    ;;
  stop)
    require_root
    require_systemd
    systemctl stop "$SERVICE"
    ;;
  restart)
    require_root
    require_systemd
    systemctl restart "$SERVICE"
    ;;
  status)
    require_systemd
    systemctl status "$SERVICE" --no-pager
    ;;
  health)
    curl --fail --silent --show-error "http://127.0.0.1:$BACKEND_PORT/ready"
    printf '\n'
    ;;
  network-check)
    network_check
    ;;
  syslog-check)
    syslog_check
    ;;
  feature-check)
    feature_check
    ;;
  database-check)
    database_check
    ;;
  login-info)
    require_root
    [[ -s "$LOGIN_FILE" ]] || {
      echo "Sign-in details file is missing: $LOGIN_FILE" >&2
      exit 1
    }
    cat "$LOGIN_FILE"
    ;;
  logs)
    require_systemd
    journalctl -u "$SERVICE" --no-pager -n "${2:-300}"
    ;;
  backup)
    require_root
    prepare_directories
    backup_state
    ;;
  uninstall)
    require_root
    require_systemd
    systemctl disable --now "$SERVICE" || true
    remove_syslog_firewall_rules
    echo 'The service was stopped. The database, backups, and configuration were preserved.'
    ;;
  version)
    installed_version
    ;;
  *)
    echo 'Usage: mme-control {install|upgrade|start|stop|restart|status|health|network-check|syslog-check|feature-check|database-check|login-info|logs [lines]|backup|uninstall|version}' >&2
    exit 2
    ;;
esac
