#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-start}"
APP_DIR="${MME_HOME:-/opt/mikrotik-manager-enterprise}"
DATA_DIR="${MME_DATA:-/var/lib/mikrotik-manager-enterprise}"
ENV_FILE="/etc/mikrotik-manager-enterprise/mme.env"
NODE="$APP_DIR/runtime/node"

require_root() { [[ $EUID -eq 0 ]] || { echo 'Lệnh này cần quyền root.' >&2; exit 1; }; }
secret() { openssl rand -hex "${1:-32}"; }

initialize_env() {
  mkdir -p "$(dirname "$ENV_FILE")" "$DATA_DIR/data" "$DATA_DIR/backups" "$DATA_DIR/logs"
  [[ -f "$ENV_FILE" ]] && return
  local admin_password
  admin_password="$(secret 12)"
  cat > "$ENV_FILE" <<EOF
NODE_ENV=production
APP_NAME=mikrotik-manager-enterprise
APP_VERSION=4.1.1
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
DATABASE_URL=file:$DATA_DIR/data/mme.db
JWT_SECRET=$(secret 32)
ENCRYPTION_KEY=$(secret 32)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=$admin_password
BACKUP_STORAGE_PATH=$DATA_DIR/backups
WEB_DIST_PATH=$APP_DIR/web
SQLITE_SCHEMA_SQL=$APP_DIR/prisma/schema.sqlite.sql
LOG_LEVEL=info
EOF
  chmod 600 "$ENV_FILE"
  printf 'URL: http://localhost:3000\nEmail: admin@example.com\nMật khẩu: %s\n' "$admin_password" \
    > /root/mme-thong-tin-dang-nhap.txt
  chmod 600 /root/mme-thong-tin-dang-nhap.txt
}

backup_data() {
  [[ -f "$DATA_DIR/data/mme.db" ]] || { echo ''; return 0; }
  mkdir -p "$DATA_DIR/backups"
  local target="$DATA_DIR/backups/mme-before-upgrade-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -czf "$target" \
    -C "$DATA_DIR" data -C /etc mikrotik-manager-enterprise
  echo "$target"
}

restore_data() {
  local archive="${1:-}"
  [[ -n "$archive" && -f "$archive" ]] || return 0
  local temporary
  temporary="$(mktemp -d)"
  trap 'rm -rf "$temporary"' RETURN
  tar -xzf "$archive" -C "$temporary"
  [[ -f "$temporary/data/mme.db" ]] && cp -f "$temporary/data/mme.db" "$DATA_DIR/data/mme.db"
}

case "$ACTION" in
  install)
    require_root; initialize_env
    backup="$(backup_data)"
    set -a; source "$ENV_FILE"; set +a
    if ! "$NODE" "$APP_DIR/dist/scripts/setup-native.js"; then
      restore_data "$backup"
      echo 'Nâng cấp thất bại; dữ liệu đã được rollback.' >&2
      exit 1
    fi
    systemctl daemon-reload
    systemctl enable --now mme.service
    echo 'MME đã cài xong. Thông tin đăng nhập: /root/mme-thong-tin-dang-nhap.txt'
    ;;
  start) require_root; systemctl start mme.service ;;
  stop) require_root; systemctl stop mme.service ;;
  restart) require_root; systemctl restart mme.service ;;
  status) systemctl status mme.service --no-pager ;;
  backup) require_root; backup_data ;;
  uninstall) require_root; systemctl disable --now mme.service || true ;;
  *) echo 'Cách dùng: mme-control {install|start|stop|restart|status|backup|uninstall}' >&2; exit 2 ;;
esac
