{
  "name": "mikrotik-manager-enterprise",
  "version": "5.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mme/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @mme/routeros-core build && pnpm --filter @mme/routeros-sdk build && pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "setup:database": "pnpm --filter @mme/server prisma:push && pnpm --filter @mme/server prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
